@using System.Threading
@using System.Text
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Floating.Windows.Abstract
@using Soenneker.Blazor.Floating.Windows.Options
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Soenneker.Blazor.Floating.Windows.Dtos
@using Soenneker.Extensions.CancellationTokens
@using Soenneker.Blazor.Utils.Ids

@inject IFloatingWindowInterop WindowInterop
@inject ILogger<FloatingWindow> Logger

@inherits Soenneker.Lepton.Suite.LeptonCancellableIdentifiableContentElement
@implements IFloatingWindow

<div id="@Id!" class="floating-window @(_visible ? "visible" : "") @(ResolvedStyleOptions.CustomClass)" style="@GetWindowStyles()" data-dark-mode="@(ResolvedStyleOptions.UseDarkMode ? "true" : "false")" >
    @if ((ShowTitleBar ?? Options.ShowTitleBar))
    {
        <div class="floating-window-titlebar" style="@GetTitleBarStyles()" >
            @if (HeaderContent != null)
            {
                @HeaderContent
            }
            else
            {
                <div class="floating-window-title" style="@GetTitleStyles()" >@((Title ?? Options.Title) ?? "Window")</div>
            }
            @if ((ShowCloseButton ?? Options.ShowCloseButton))
            {
                <button class="floating-window-close" type="button" aria-label="Close" style="@GetCloseButtonStyles()" @onclick="OnCloseClick" >
                    <span>&times;</span>
                </button>
            }
        </div>
    }

    <div class="floating-window-content" style="@GetContentStyles()" >
        @ChildContent
    </div>

    @if ((Resizable ?? Options.Resizable))
    {
        <div class="floating-window-resize-handle resize-n" data-direction="n" ></div>
        <div class="floating-window-resize-handle resize-e" data-direction="e" ></div>
        <div class="floating-window-resize-handle resize-s" data-direction="s" ></div>
        <div class="floating-window-resize-handle resize-w" data-direction="w" ></div>
        <div class="floating-window-resize-handle resize-ne" data-direction="ne" ></div>
        <div class="floating-window-resize-handle resize-nw" data-direction="nw" ></div>
        <div class="floating-window-resize-handle resize-se" data-direction="se" ></div>
        <div class="floating-window-resize-handle resize-sw" data-direction="sw" ></div>
    }
</div>

@code {

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    public FloatingWindow()
    {
        Id = BlazorIdGenerator.New("fw");
    }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback OnShow { get; set; }

    [Parameter]
    public EventCallback OnHide { get; set; }

    [Parameter]
    public EventCallback OnDragStart { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    [Parameter]
    public FloatingWindowOptions Options { get; set; } = new();

    [Parameter]
    public bool? Draggable { get; set; }

    [Parameter]
    public bool? Resizable { get; set; }

    [Parameter]
    public bool? ShowCloseButton { get; set; }

    [Parameter]
    public bool? ShowTitleBar { get; set; }

    [Parameter]
    public bool? Enabled { get; set; }

    [Parameter]
    public int? InitialX { get; set; }

    [Parameter]
    public int? InitialY { get; set; }

    [Parameter]
    public bool? UseCdn { get; set; }

    [Parameter]
    public FloatingWindowStyleOptions? StyleOptions { get; set; }

    [Parameter]
    public bool? AutoSizeToContent { get; set; }

    [Parameter]
    public bool? DynamicAutoSizeToContent { get; set; }

    [Parameter]
    public bool? RecenterOnResize { get; set; }

    public bool IsVisible => _visible;

    private FloatingWindowStyleOptions ResolvedStyleOptions => StyleOptions ?? Options.StyleOptions;

    private FloatingWindowOptions MergedOptions => new()
    {
        Draggable = Draggable ?? Options.Draggable,
        Resizable = Resizable ?? Options.Resizable,
        ShowCloseButton = ShowCloseButton ?? Options.ShowCloseButton,
        ShowTitleBar = ShowTitleBar ?? Options.ShowTitleBar,
        Title = Title ?? Options.Title,
        Enabled = Enabled ?? Options.Enabled,
        InitialX = InitialX ?? Options.InitialX,
        InitialY = InitialY ?? Options.InitialY,
        MinWidth = Options.MinWidth,
        MinHeight = Options.MinHeight,
        MaxWidth = Options.MaxWidth,
        MaxHeight = Options.MaxHeight,
        ConstrainToViewport = Options.ConstrainToViewport,
        CenterOnShow = Options.CenterOnShow,
        FocusOnShow = Options.FocusOnShow,
        UseCdn = UseCdn ?? Options.UseCdn,
        ZIndex = Options.ZIndex,
        StyleOptions = StyleOptions ?? Options.StyleOptions,
        AutoSizeToContent = AutoSizeToContent ?? Options.AutoSizeToContent,
        DynamicAutoSizeToContent = DynamicAutoSizeToContent ?? Options.DynamicAutoSizeToContent,
        RecenterOnResize = RecenterOnResize ?? Options.RecenterOnResize
    };

    private bool _initialized;
    private bool _visible;
    private DotNetObjectReference<FloatingWindow>? _dotNetRef;

    [JSInvokable]
    public Task InvokeOnShow()
    {
        _visible = true;
        return OnShow.InvokeIfHasDelegate();
    }

    [JSInvokable]
    public Task InvokeOnHide()
    {
        _visible = false;
        return OnHide.InvokeIfHasDelegate();
    }

    [JSInvokable]
    public Task InvokeOnDragStart()
    {
        return OnDragStart.InvokeIfHasDelegate();
    }

    [JSInvokable]
    public Task InvokeOnDragEnd()
    {
        return OnDragEnd.InvokeIfHasDelegate();
    }

    [JSInvokable]
    public async Task OnContentResized()
    {
        if ((RecenterOnResize ?? Options.RecenterOnResize))
        {
            await Center();
        }
    }

    private async Task OnCloseClick()
    {
        await Hide();
    }

    public async ValueTask Center(CancellationToken cancellationToken = default)
    {
        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            try
            {
                FloatingWindowSize windowSize = await WindowInterop.GetSize(Id!, linked);
                FloatingWindowSize viewportSize = await WindowInterop.GetViewportSize(linked);

                int x = (viewportSize.Width - windowSize.Width) / 2;
                int y = (viewportSize.Height - windowSize.Height) / 2;

                await WindowInterop.SetPosition(Id!, x, y, linked);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error centering window");
                // Fallback to default positioning
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // if (Height.HasValue)
            //     MergedOptions.Height = Height.Value;

            await WindowInterop.Initialize((UseCdn ?? Options.UseCdn), CancellationToken);
            _dotNetRef = DotNetObjectReference.Create(this);

            // Wait a bit to ensure the element is in the DOM
            await Task.Delay(10, CancellationToken);

            await WindowInterop.Create(Id!, MergedOptions, CancellationToken);
            await WindowInterop.SetCallbacks(Id!, _dotNetRef!, CancellationToken);

            // Set initialized after everything is done
            _initialized = true;
            StateHasChanged();
        }
    }

    public async ValueTask Show(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
            {
                try
                {
                    if (Options.CenterOnShow)
                    {
                        await WindowInterop.CenterInViewport(Id!, linked);
                    }

                    await WindowInterop.Show(Id!, linked);
                    _visible = true;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError("Error showing window {S}: {ExMessage}", Id!, ex.Message);
                }
            }
        }
        else
        {
            Logger.LogWarning("Window {S} not initialized yet", Id!);
        }
    }

    public async ValueTask Hide(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                await WindowInterop.Hide(Id!, linked);
            _visible = false;
        }
    }

    public async ValueTask Toggle(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                await WindowInterop.Toggle(Id!, linked);
            _visible = !_visible;
        }
    }

    public async ValueTask Close(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                await WindowInterop.Close(Id!, linked);
            _visible = false;
        }
    }

    public async ValueTask<(int x, int y)> GetPosition(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                return await WindowInterop.GetPosition(Id!, linked);
        }

        return (0, 0);
    }

    public async ValueTask SetPosition(int x, int y, CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                await WindowInterop.SetPosition(Id!, x, y, linked);
        }
    }

    public async ValueTask<FloatingWindowSize> GetSize(CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                return await WindowInterop.GetSize(Id!, linked);
        }

        return new FloatingWindowSize { Width = 0, Height = 0 };
    }

    public async ValueTask SetSize(int width, int height, CancellationToken cancellationToken = default)
    {
        if (_initialized)
        {
            CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

            using (cts)
                await WindowInterop.SetSize(Id!, width, height, linked);
        }
    }


    public async ValueTask Destroy(CancellationToken cancellationToken = default)
    {
        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
            await WindowInterop.Destroy(Id!, linked);

        _initialized = false;
        _visible = false;
    }

    private string GetWindowStyles()
    {
        FloatingWindowStyleOptions style = ResolvedStyleOptions;
        var builder = new StringBuilder(1024);
        builder.Append($"background-color: {style.BackgroundColor}");
        builder.Append($"; border: {style.BorderWidth} solid {style.BorderColor}");
        builder.Append($"; border-radius: {style.BorderRadius}");
        builder.Append($"; box-shadow: {style.BoxShadow}");
        builder.Append($"; color: {style.TextColor}");
        builder.Append($"; font-family: {style.FontFamily}");
        builder.Append($"; font-size: {style.FontSize}");
        builder.Append($"; line-height: {style.LineHeight}");
        builder.Append($"; min-width: {style.MinWidth}");
        builder.Append($"; min-height: {style.MinHeight}");
        builder.Append($"; z-index: {style.ZIndex}");
        builder.Append($"; transition: opacity {style.TransitionDuration} {style.TransitionTimingFunction}, transform {style.TransitionDuration} {style.TransitionTimingFunction}");
        builder.Append($"; --close-button-hover-bg: {style.CloseButtonHoverBackgroundColor}");
        builder.Append($"; --close-button-active-bg: {style.CloseButtonActiveBackgroundColor}");
        builder.Append($"; --resize-handle-hover-bg: {style.ResizeHandleHoverBackgroundColor}");
        builder.Append($"; --focus-box-shadow: {style.BoxShadow}, 0 0 0 {style.FocusBorderWidth} {style.FocusBorderColor}");

        if (style.CustomStyles != null)
        {
            foreach (KeyValuePair<string, string> customStyle in style.CustomStyles)
                builder.Append($"; {customStyle.Key}: {customStyle.Value}");
        }

        return builder.ToString();
    }

    private string GetTitleBarStyles()
    {
        FloatingWindowStyleOptions style = ResolvedStyleOptions;
        return $"background: {style.TitleBarBackgroundGradient ?? style.TitleBarBackgroundColor}; color: {style.TitleBarTextColor}; font-weight: {style.TitleBarFontWeight}; font-size: {style.TitleBarFontSize}; padding: {style.TitleBarPadding}; border-bottom: 1px solid {style.TitleBarBorderBottomColor}";
    }

    private string GetTitleStyles()
    {
        FloatingWindowStyleOptions style = ResolvedStyleOptions;
        return $"color: {style.TitleBarTextColor}; font-weight: {style.TitleBarFontWeight}; font-size: {style.TitleBarFontSize}";
    }

    private string GetCloseButtonStyles()
    {
        FloatingWindowStyleOptions style = ResolvedStyleOptions;
        return $"background-color: {style.CloseButtonBackgroundColor}; color: {style.CloseButtonTextColor}; border-radius: {style.CloseButtonBorderRadius}; font-size: {style.CloseButtonFontSize}; transition: background-color {style.TransitionDuration} {style.TransitionTimingFunction}";
    }

    private string GetContentStyles()
    {
        FloatingWindowStyleOptions style = ResolvedStyleOptions;
        return $"padding: {style.ContentPadding}; color: {style.TextColor}";
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            if (_initialized)
                await WindowInterop.Destroy(Id!, CancellationToken.None);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        _dotNetRef?.Dispose();
        await base.DisposeAsync();
    }

}
